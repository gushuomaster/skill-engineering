{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider_id", "capability", "provider_status", "findings",
    "candidate_changes", "evidence", "limitations", "fallback_used"
    , "deliverable_contract", "capability_manifest"
  ],
  "properties": {
    "provider_id": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
    "provider_status": {"enum": ["AVAILABLE", "UNAVAILABLE", "INVALID_OUTPUT", "TIMEOUT", "INCOMPATIBLE", "DEGRADED"]},
    "findings": {"type": "array", "items": {"type": "string"}},
    "candidate_changes": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "fallback_used": {"type": "boolean"},
    "deliverable_contract": {
      "anyOf": [
        {"$ref": "#/$defs/deliverableContract"},
        {"type": "null"}
      ]
    },
    "capability_manifest": {
      "anyOf": [
        {"$ref": "#/$defs/capabilityManifest"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "deliverableStatus": {
      "enum": ["present", "missing", "unknown", "not_applicable"]
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deliverable_id", "declared_status", "declarations",
        "exposure_status", "exposure_entrypoint", "exposure_selector",
        "exposure_evidence", "implementation_status",
        "implementation_dispatch_route", "implementation_artifact_pattern",
        "implementation_evidence", "behavioral_status", "behavioral_commands",
        "expected_artifacts", "behavioral_evidence"
      ],
      "properties": {
        "deliverable_id": {"type": "string", "minLength": 1},
        "declared_status": {"enum": ["implemented", "planned", "registered_only", "unknown"]},
        "declarations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "exposure_status": {"$ref": "#/$defs/deliverableStatus"},
        "exposure_entrypoint": {"type": ["string", "null"]},
        "exposure_selector": {"type": ["string", "null"]},
        "exposure_evidence": {"type": "array", "items": {"type": "string"}},
        "implementation_status": {"$ref": "#/$defs/deliverableStatus"},
        "implementation_dispatch_route": {"type": ["string", "null"]},
        "implementation_artifact_pattern": {"type": ["string", "null"]},
        "implementation_evidence": {"type": "array", "items": {"type": "string"}},
        "behavioral_status": {"$ref": "#/$defs/deliverableStatus"},
        "behavioral_commands": {"type": "array", "items": {"type": "string"}},
        "expected_artifacts": {"type": "array", "items": {"type": "string"}},
        "behavioral_evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "deliverableContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "inspection_id", "target_digest", "inspection_nonce",
        "provider_identity", "deliverables", "scope_conflicts",
        "applicability_status", "applicability_reason", "applicability_evidence",
        "evidence_origin"
      ],
      "properties": {
        "schema_version": {"type": "string", "const": "1.0"},
        "inspection_id": {"type": "string", "minLength": 1},
        "target_digest": {"type": "string", "minLength": 1},
        "inspection_nonce": {"type": "string", "minLength": 1},
        "provider_identity": {"type": "string", "minLength": 1},
        "deliverables": {"type": "array", "items": {"$ref": "#/$defs/deliverable"}},
        "scope_conflicts": {"type": "array", "items": {"type": "string"}},
        "applicability_status": {"enum": ["applicable", "not_applicable", "unknown"]},
        "applicability_reason": {"type": "string", "minLength": 1},
        "applicability_evidence": {"type": "array", "items": {"type": "string"}},
        "evidence_origin": {"enum": ["provider", "target_self_report"]}
      }
    },
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id", "public_name", "capability_type", "declared_status",
        "implementation_status", "entrypoints", "supported_profiles",
        "supported_deliverables", "templates", "schemas", "validation_coverage",
        "public_claim_sources", "implementation_evidence", "confidence",
        "evidence_state"
      ],
      "properties": {
        "capability_id": {"type": "string", "minLength": 1},
        "public_name": {"type": "string", "minLength": 1},
        "capability_type": {"type": "string", "minLength": 1},
        "declared_status": {"type": "string", "minLength": 1},
        "implementation_status": {"type": "string", "minLength": 1},
        "entrypoints": {"$ref": "#/$defs/stringArray"},
        "supported_profiles": {"$ref": "#/$defs/stringArray"},
        "supported_deliverables": {"$ref": "#/$defs/stringArray"},
        "templates": {"$ref": "#/$defs/stringArray"},
        "schemas": {"$ref": "#/$defs/stringArray"},
        "validation_coverage": {"$ref": "#/$defs/stringArray"},
        "public_claim_sources": {"$ref": "#/$defs/stringArray"},
        "implementation_evidence": {"$ref": "#/$defs/stringArray"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_state": {"enum": ["COMPLETE", "UNVERIFIABLE"]}
      }
    },
    "capabilityManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "inspection_id", "inspection_nonce", "artifact_role",
        "artifact_digest", "provider_identity", "capabilities",
        "public_output_contract_status", "public_output_contract_evidence",
        "evidence_origin"
      ],
      "properties": {
        "schema_version": {"type": "string", "const": "1.0"},
        "inspection_id": {"type": "string", "minLength": 1},
        "inspection_nonce": {"type": "string", "minLength": 1},
        "artifact_role": {"enum": ["BASELINE", "CANDIDATE"]},
        "artifact_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "provider_identity": {"type": "string", "minLength": 1},
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
        "public_output_contract_status": {"enum": ["present", "absent", "unknown"]},
        "public_output_contract_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_origin": {"type": "string", "const": "provider"}
      }
    }
  }
}
