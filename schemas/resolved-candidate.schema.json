{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resolution_id", "discovery_bundle_digest", "selection_record_digest", "candidate_id", "name", "source_type", "source_id", "source_uri", "fetch_reference", "resolved_revision", "immutability_status", "immutability_evidence", "quarantine_path", "candidate_digest", "resolver", "resolved_at", "resolution_record_digest"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "resolution_id": {"type": "string", "minLength": 1},
    "discovery_bundle_digest": {"$ref": "#/$defs/digest"},
    "selection_record_digest": {"$ref": "#/$defs/digest"},
    "candidate_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_uri": {"type": ["string", "null"]},
    "fetch_reference": {"type": "string", "minLength": 1},
    "resolved_revision": {"type": ["string", "null"]},
    "immutability_status": {"enum": ["PROVEN", "UNPROVEN"]},
    "immutability_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "quarantine_path": {"type": "string", "minLength": 1},
    "candidate_digest": {"$ref": "#/$defs/digest"},
    "resolver": {"type": "string", "minLength": 1},
    "resolved_at": {"type": "string", "minLength": 1},
    "resolution_record_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {"if": {"properties": {"immutability_status": {"const": "PROVEN"}}}, "then": {"properties": {"resolved_revision": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"immutability_status": {"const": "UNPROVEN"}}}, "then": {"properties": {"resolved_revision": {"type": "null"}}}}
  ],
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
